# Elabora AI — server-side only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000

# Supabase Auth + authenticated usage quota
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FREE_CONSULTATIONS_LIMIT=3
DAILY_FREE_CONSULTATIONS_LIMIT=100

# Stripe — server-side only
# Configure secrets separately per Vercel environment:
# Preview = sandbox credentials; Production = live credentials.
# Price IDs are selected automatically by VERCEL_ENV in lib/billing.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used only as metadata in OpenRouter requests.
NEXT_PUBLIC_SITE_URL=https://elaborae.vercel.app
